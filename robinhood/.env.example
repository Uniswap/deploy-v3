# ── shared ──────────────────────────────────────────────────────────────────
# Deployer EOA. Initial hook owner; hand off to the multisig with 03_HandOff.
PRIVATE_KEY=
# Set after 00_DeployBandHook:
HOOK=
# Final owner (multisig on Robinhood Chain) for 03_HandOff:
NEW_OWNER=

# Robinhood Chain: rpc alias "robinhood" is in foundry.toml (chain id 4663)
# PoolManager 0x8366a39CC670B4001A1121B8F6A443A643e40951 is hardcoded in scripts.

# ── pool: ETH/HOLLAR  (save as .env.eth-hollar) ─────────────────────────────
# currency0 = native ETH; currency1 = bridged HOLLAR (fill in when bridged).
# Requires address(HOLLAR) > 0x0 — always true — and no sorting concern.
#CURRENCY0=0x0000000000000000000000000000000000000000
#CURRENCY1=<HOLLAR>
#TICK_SPACING=10
# Chainlink ETH/USD on Robinhood Chain (8 dec, 0.5% dev / 24h heartbeat).
# Feed base = ETH = pool currency0 -> no invert. HOLLAR treated as $1 (open decision #1).
#FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9
#FEED_INVERT=false
#FEED_BASE_DECIMALS=18          # ETH
#FEED_QUOTE_DECIMALS=18         # HOLLAR (confirm bridged decimals)
#FEE_FLOOR_PPM=800              # 0.08%
#FEE_CAP_PPM=10000              # 1%
#FEE_SLOPE_PPM=1000000          # +1% fee per 1% divergence
#STALE_AFTER_S=100800           # 28h: ETH/USD heartbeat is 24h
#HALF_BAND_TICKS=700            # ±7%
#BACKSTOP_HALF_TICKS=11000      # ÷3..×3
#BACKSTOP_BPS=3500
#TRIGGER_TICKS=350              # ~3.5% drift
#GUARD_TICKS=150                # ~1.5%

# ── pool: HDX/HOLLAR  (save as .env.hdx-hollar) ─────────────────────────────
# Sort HDX vs HOLLAR addresses once both are bridged; set CURRENCY0 < CURRENCY1.
# FEED = HDX/USD ManagedOracle (wormhole-direct, 8 dec).
# If HDX is currency0: FEED_INVERT=false, BASE=HDX decimals, QUOTE=HOLLAR decimals.
# If HDX is currency1: FEED_INVERT=true,  BASE=HDX decimals, QUOTE=HOLLAR decimals swapped accordingly.
#CURRENCY0=<lower address>
#CURRENCY1=<higher address>
#TICK_SPACING=60
#FEED=<HDX-USD ManagedOracle>
#FEED_INVERT=<see above>
#FEED_BASE_DECIMALS=<HDX bridged decimals — confirm, 12 on Hydration>
#FEED_QUOTE_DECIMALS=<HOLLAR bridged decimals>
#FEE_FLOOR_PPM=3000             # 0.3%
#FEE_CAP_PPM=20000              # 2%
#FEE_SLOPE_PPM=1000000
#STALE_AFTER_S=7200             # 2h: our feed heartbeats every 30 min
#HALF_BAND_TICKS=1000           # ±10%
#BACKSTOP_HALF_TICKS=16000      # ÷5..×5
#BACKSTOP_BPS=3500
#TRIGGER_TICKS=500              # ~5%
#GUARD_TICKS=200                # ~2%

# ── pool: ETH/HDX  (save as .env.eth-hdx) ───────────────────────────────────
# currency0 = native ETH; currency1 = bridged HDX.
# FEED = HDX/ETH ManagedOracle (wormhole-direct: Hydration omnipool HDX/WETH EMA).
# Feed base = HDX = currency1 -> FEED_INVERT=true (we need HDX-per-ETH raw).
#CURRENCY0=0x0000000000000000000000000000000000000000
#CURRENCY1=<HDX>
#TICK_SPACING=60
#FEED=<HDX-ETH ManagedOracle>
#FEED_INVERT=true
#FEED_BASE_DECIMALS=<HDX bridged decimals>
#FEED_QUOTE_DECIMALS=18         # ETH
#FEE_FLOOR_PPM=3000
#FEE_CAP_PPM=20000
#FEE_SLOPE_PPM=1000000
#STALE_AFTER_S=7200
#HALF_BAND_TICKS=1000
#BACKSTOP_HALF_TICKS=16000
#BACKSTOP_BPS=3500
#TRIGGER_TICKS=500
#GUARD_TICKS=200

# ── funding (02_Fund) ───────────────────────────────────────────────────────
# POOL_ID printed by 01_SetupPool. Amounts in raw units; amount0 for a native
# pool is sent as msg.value by the script.
#POOL_ID=
#FUND_AMOUNT0=
#FUND_AMOUNT1=
